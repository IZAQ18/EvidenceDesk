EVIDENCEDESK_ENV=development
# Database backend: SQLite for local/pilot; PostgreSQL for durable multi-instance deployment.
EVIDENCEDESK_DATABASE_BACKEND=sqlite
EVIDENCEDESK_DB_PATH=data/evidencedesk.db
# EVIDENCEDESK_DATABASE_URL=postgresql://user:password@host:5432/evidencedesk
# AWS/ECS can instead inject the RDS managed secret as separate components:
# EVIDENCEDESK_DATABASE_HOST=database.example.us-east-1.rds.amazonaws.com
# EVIDENCEDESK_DATABASE_PORT=5432
# EVIDENCEDESK_DATABASE_NAME=evidencedesk
# EVIDENCEDESK_DATABASE_USER=evidencedesk_admin
# EVIDENCEDESK_DATABASE_PASSWORD=server-only-secret
# EVIDENCEDESK_DATABASE_SSLMODE=verify-full
# Bound the number of database connections opened by each application instance.
# EVIDENCEDESK_DATABASE_POOL_MIN_SIZE=1
# EVIDENCEDESK_DATABASE_POOL_MAX_SIZE=5
# EVIDENCEDESK_DATABASE_POOL_TIMEOUT_SECONDS=10
EVIDENCEDESK_DOCUMENT_STORE_PATH=data/originals
# Original storage backend: local for development/pilot, s3 for a durable deployment.
EVIDENCEDESK_DOCUMENT_STORE_BACKEND=local
# EVIDENCEDESK_S3_BUCKET=evidencedesk-private-dev
# EVIDENCEDESK_S3_PREFIX=evidencedesk/originals
# EVIDENCEDESK_S3_REGION=us-east-1
# Optional S3-compatible HTTPS endpoint, KMS key, and AWS account ownership check:
# EVIDENCEDESK_S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# EVIDENCEDESK_S3_KMS_KEY_ID=alias/evidencedesk-documents
# EVIDENCEDESK_S3_EXPECTED_BUCKET_OWNER=123456789012
# Operator-only HMAC key for authenticating backup/restore acceptance manifests.
# Keep it outside the application task and use the same value before and after restore.
# EVIDENCEDESK_DURABILITY_MANIFEST_KEY=replace-with-at-least-32-random-characters
EVIDENCEDESK_MAX_UPLOAD_BYTES=10000000
# Hybrid retrieval reviews only an authorization-filtered candidate pool. The local semantic
# encoder is deterministic and dependency-free; it is not a neural embedding model.
EVIDENCEDESK_SEMANTIC_CANDIDATE_LIMIT=600
EVIDENCEDESK_SEMANTIC_MIN_SCORE=0.08
# Optional server-managed answer synthesis. Leave false until a private server key,
# current provider prices, and a deliberate daily spend ceiling are configured.
# Visitors never paste this key. Only the question and selected authorized excerpts are sent.
EVIDENCEDESK_MODEL_GATEWAY_ENABLED=false
# EVIDENCEDESK_MODEL_API_KEY=replace-with-a-server-only-project-key
# EVIDENCEDESK_MODEL_BASE_URL=https://api.openai.com/v1
# EVIDENCEDESK_MODEL_NAME=gpt-5-mini
# EVIDENCEDESK_MODEL_TIMEOUT_SECONDS=20
# EVIDENCEDESK_MODEL_MAX_EVIDENCE_CHARS=12000
# EVIDENCEDESK_MODEL_MAX_OUTPUT_TOKENS=600
# EVIDENCEDESK_MODEL_DAILY_REQUEST_LIMIT=100
# EVIDENCEDESK_MODEL_DAILY_TOKEN_LIMIT=250000
# EVIDENCEDESK_MODEL_DAILY_COST_LIMIT_CENTS=100
# Copy current USD-per-million-token prices from the provider; do not guess them.
# EVIDENCEDESK_MODEL_INPUT_PRICE_PER_MILLION_USD=0.00
# EVIDENCEDESK_MODEL_OUTPUT_PRICE_PER_MILLION_USD=0.00
# Durable database-backed upload jobs. The bundled worker is practical for local/pilot use;
# use a separately deployed worker and managed queue for an official multi-instance launch.
EVIDENCEDESK_INGESTION_WORKER_ENABLED=true
EVIDENCEDESK_INGESTION_WORKER_POLL_SECONDS=0.5
EVIDENCEDESK_INGESTION_JOB_LEASE_SECONDS=300
EVIDENCEDESK_INGESTION_JOB_MAX_ATTEMPTS=3
# Production acceptance should use a private clamd endpoint and fail closed when it is unavailable.
# EVIDENCEDESK_MALWARE_SCANNER_BACKEND=clamd
# EVIDENCEDESK_MALWARE_SCAN_REQUIRED=true
# EVIDENCEDESK_CLAMD_HOST=clamd.internal
# EVIDENCEDESK_CLAMD_PORT=3310
# EVIDENCEDESK_MALWARE_SCAN_TIMEOUT_SECONDS=15
# Run parsers/OCR in a secret-scrubbed child process with bounded time and POSIX resources.
# EVIDENCEDESK_INGESTION_PROCESS_ISOLATION_ENABLED=true
# EVIDENCEDESK_INGESTION_EXTRACTION_TIMEOUT_SECONDS=120
# EVIDENCEDESK_INGESTION_WORKER_MEMORY_MB=1024
# EVIDENCEDESK_INGESTION_WORKER_CPU_SECONDS=90
# EVIDENCEDESK_INGESTION_MAX_EXTRACTED_CHARS=5000000
EVIDENCEDESK_RATE_LIMIT_PER_MINUTE=60
EVIDENCEDESK_AUTH_MODE=api_key
# Optional private-account foundation. Leave disabled for the protected portfolio pilot.
# When enabled, every registration creates an isolated personal workspace and the browser
# uses an HttpOnly session instead of asking the customer for an API key.
# EVIDENCEDESK_ACCOUNTS_ENABLED=true
# EVIDENCEDESK_ACCOUNT_REGISTRATION_ENABLED=true
# EVIDENCEDESK_ACCOUNT_SESSION_HOURS=168
# Keep these off until managed PostgreSQL, SMTP, privacy, and recovery acceptance are complete.
# EVIDENCEDESK_ACCOUNT_EMAIL_VERIFICATION_REQUIRED=false
# EVIDENCEDESK_ACCOUNT_PASSWORD_RESET_ENABLED=false
# EVIDENCEDESK_ACCOUNT_INVITATIONS_ENABLED=false
# EVIDENCEDESK_ACCOUNT_EXPORT_ENABLED=false
# EVIDENCEDESK_ACCOUNT_DELETION_ENABLED=false
# EVIDENCEDESK_ACCOUNT_VERIFICATION_TOKEN_HOURS=24
# EVIDENCEDESK_ACCOUNT_PASSWORD_RESET_TOKEN_MINUTES=30
# EVIDENCEDESK_ACCOUNT_INVITATION_HOURS=72
# EVIDENCEDESK_ACCOUNT_EXPORT_MAX_BYTES=250000000
# EVIDENCEDESK_EMAIL_DELIVERY_BACKEND=smtp
# EVIDENCEDESK_SMTP_HOST=smtp.example.com
# EVIDENCEDESK_SMTP_PORT=587
# EVIDENCEDESK_SMTP_USERNAME=server-only-user
# EVIDENCEDESK_SMTP_PASSWORD=server-only-secret
# EVIDENCEDESK_SMTP_FROM_ADDRESS=EvidenceDesk <accounts@example.com>
# EVIDENCEDESK_SMTP_STARTTLS=true
# Optional OIDC mode (api_key, oidc, or hybrid):
# EVIDENCEDESK_OIDC_ISSUER=https://identity.example.com/
# EVIDENCEDESK_OIDC_AUDIENCE=evidencedesk-api
# EVIDENCEDESK_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
EVIDENCEDESK_OCR_ENABLED=true
EVIDENCEDESK_OCR_LANGUAGES=eng
EVIDENCEDESK_OCR_DPI=200
EVIDENCEDESK_OCR_MAX_PAGES=30
# On Windows, set this after installing Tesseract OCR:
# EVIDENCEDESK_TESSDATA_PATH=C:/Program Files/Tesseract-OCR/tessdata
# JSON map: key -> principal. Replace development keys before sharing.
# EVIDENCEDESK_API_KEYS={"replace-me":{"subject":"admin","tenant_id":"demo","role":"admin","clearances":["public","internal","confidential"]}}

# Optional protected portfolio pilot. Use a random value of at least 24 characters.
# This replaces the API-key field in the browser with an HttpOnly pilot session.
# EVIDENCEDESK_PILOT_ACCESS_CODE=replace-with-a-long-random-access-code
# EVIDENCEDESK_PILOT_SESSION_HOURS=12
# EVIDENCEDESK_PILOT_TENANT_ID=pilot
# EVIDENCEDESK_SEED_DEMO_CONTENT=true
# EVIDENCEDESK_EXPOSE_API_DOCS=false
# EVIDENCEDESK_PUBLIC_BASE_URL=https://your-service.onrender.com
# Optional provider-hosted links. HTTPS only; never publish bank details.
# EVIDENCEDESK_CHECKOUT_URL=https://your-store.example/checkout/buy/your-product
# EVIDENCEDESK_SUPPORT_URL=https://your-provider.example/your-checkout
# Optional signed payment notifications. Generate this in the provider dashboard.
# EVIDENCEDESK_PAYMENT_WEBHOOK_SECRET=replace-with-a-provider-webhook-secret
# EVIDENCEDESK_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.onrender.com
