EVIDENCEDESK_ENV=development
EVIDENCEDESK_DB_PATH=data/evidencedesk.db
EVIDENCEDESK_DOCUMENT_STORE_PATH=data/originals
# Original storage backend: local for development/pilot, s3 for a durable deployment.
EVIDENCEDESK_DOCUMENT_STORE_BACKEND=local
# EVIDENCEDESK_S3_BUCKET=evidencedesk-private-dev
# EVIDENCEDESK_S3_PREFIX=evidencedesk/originals
# EVIDENCEDESK_S3_REGION=us-east-1
# Optional S3-compatible HTTPS endpoint, KMS key, and AWS account ownership check:
# EVIDENCEDESK_S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# EVIDENCEDESK_S3_KMS_KEY_ID=alias/evidencedesk-documents
# EVIDENCEDESK_S3_EXPECTED_BUCKET_OWNER=123456789012
EVIDENCEDESK_MAX_UPLOAD_BYTES=10000000
EVIDENCEDESK_RATE_LIMIT_PER_MINUTE=60
EVIDENCEDESK_AUTH_MODE=api_key
# Optional private-account foundation. Leave disabled for the protected portfolio pilot.
# When enabled, every registration creates an isolated personal workspace and the browser
# uses an HttpOnly session instead of asking the customer for an API key.
# EVIDENCEDESK_ACCOUNTS_ENABLED=true
# EVIDENCEDESK_ACCOUNT_REGISTRATION_ENABLED=true
# EVIDENCEDESK_ACCOUNT_SESSION_HOURS=168
# Optional OIDC mode (api_key, oidc, or hybrid):
# EVIDENCEDESK_OIDC_ISSUER=https://identity.example.com/
# EVIDENCEDESK_OIDC_AUDIENCE=evidencedesk-api
# EVIDENCEDESK_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
EVIDENCEDESK_OCR_ENABLED=true
EVIDENCEDESK_OCR_LANGUAGES=eng
EVIDENCEDESK_OCR_DPI=200
EVIDENCEDESK_OCR_MAX_PAGES=30
# On Windows, set this after installing Tesseract OCR:
# EVIDENCEDESK_TESSDATA_PATH=C:/Program Files/Tesseract-OCR/tessdata
# JSON map: key -> principal. Replace development keys before sharing.
# EVIDENCEDESK_API_KEYS={"replace-me":{"subject":"admin","tenant_id":"demo","role":"admin","clearances":["public","internal","confidential"]}}

# Optional protected portfolio pilot. Use a random value of at least 24 characters.
# This replaces the API-key field in the browser with an HttpOnly pilot session.
# EVIDENCEDESK_PILOT_ACCESS_CODE=replace-with-a-long-random-access-code
# EVIDENCEDESK_PILOT_SESSION_HOURS=12
# EVIDENCEDESK_PILOT_TENANT_ID=pilot
# EVIDENCEDESK_SEED_DEMO_CONTENT=true
# EVIDENCEDESK_EXPOSE_API_DOCS=false
# EVIDENCEDESK_PUBLIC_BASE_URL=https://your-service.onrender.com
# Optional provider-hosted links. HTTPS only; never publish bank details.
# EVIDENCEDESK_CHECKOUT_URL=https://your-store.example/checkout/buy/your-product
# EVIDENCEDESK_SUPPORT_URL=https://your-provider.example/your-checkout
# Optional signed payment notifications. Generate this in the provider dashboard.
# EVIDENCEDESK_PAYMENT_WEBHOOK_SECRET=replace-with-a-provider-webhook-secret
# EVIDENCEDESK_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.onrender.com
